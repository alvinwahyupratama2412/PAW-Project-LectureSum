<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/theme.js" defer></script>
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <a class="brand" href="/" aria-label="LectureSum beranda">
                <span class="brand-mark">L</span>
                <span>Lecture<span class="brand-light">Sum</span></span>
            </a>
            <div class="topbar-actions">
                <span class="workspace-label"><span class="online-dot"></span> Ruang Dosen</span>
                <button class="theme-switch" id="themeToggle" type="button" role="switch" aria-checked="false" aria-label="Aktifkan tema gelap" title="Ganti tema">
                    <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.8"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
                    <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.7 8.7 0 1 0 20.5 14.1Z"/></svg>
                    <span class="switch-track"><span class="switch-thumb"></span></span>
                </button>
            </div>
        </header>

        <main class="form-page">
            <a href="/" class="back-link"><span aria-hidden="true">←</span> Kembali ke dashboard</a>
            <section class="form-card">
                <div class="form-heading">
                    <div class="form-heading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                    </div>
                    <div>
                        <p class="eyebrow">MANAJEMEN PERKULIAHAN</p>
                        <h1><%= materi ? 'Edit Materi' : 'Tambah Materi Baru' %></h1>
                        <p class="page-subtitle">Lengkapi informasi materi dan unggah dokumen perkuliahan.</p>
                    </div>
                </div>

                <form id="materiForm" class="materi-form">
                    <input type="hidden" id="materiId" value="<%= materi ? materi.id : '' %>">
                    <div class="form-grid">
                        <div class="field-group">
                            <label for="mataKuliah">Mata Kuliah <span>*</span></label>
                            <input type="text" id="mataKuliah" value="<%= materi ? materi.mata_kuliah : '' %>" placeholder="Contoh: Pemrograman Web" required>
                        </div>
                        <div class="field-group">
                            <label for="pertemuan">Pertemuan <span>*</span></label>
                            <input type="number" id="pertemuan" value="<%= materi ? materi.pertemuan : '' %>" min="1" placeholder="Contoh: 7" required>
                        </div>
                        <div class="field-group field-full">
                            <label for="judul">Judul Materi <span>*</span></label>
                            <input type="text" id="judul" value="<%= materi ? materi.judul : '' %>" placeholder="Masukkan judul materi perkuliahan" required>
                        </div>
                        <div class="field-group field-full">
                            <label for="status">Status Materi</label>
                            <select id="status">
                                <option value="Belum dipelajari" <%= !materi || materi.status === 'Belum dipelajari' || materi.status === 'Draf' ? 'selected' : '' %>>Belum dipelajari</option>
                                <option value="Sedang dipelajari" <%= materi && materi.status === 'Sedang dipelajari' ? 'selected' : '' %>>Sedang dipelajari</option>
                                <option value="Sudah Dipelajari" <%= materi && (materi.status === 'Sudah Dipelajari' || materi.status === 'Terbit') ? 'selected' : '' %>>Sudah Dipelajari</option>
                            </select>
                            <small class="field-hint">Atur progres belajar materi ini.</small>
                        </div>
                    </div>

                    <div class="upload-section">
                        <div class="upload-heading">
                            <div class="upload-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5"/><path d="M5 14v5h14v-5"/></svg></div>
                            <div><label for="file_dokumen">Dokumen Materi <span>*</span></label><p>Unggah dokumen untuk diproses dan diringkas oleh Gemini AI.</p></div>
                        </div>
                        <label class="drop-zone" id="dropZone" for="file_dokumen">
                            <input type="file" id="file_dokumen" accept=".pdf,.txt,application/pdf,text/plain">
                            <span class="drop-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5"/><path d="M5 14v5h14v-5"/></svg></span>
                            <strong id="fileName">Klik untuk memilih dokumen</strong>
                            <span class="drop-caption">atau tarik file ke area ini</span>
                            <span class="file-format">Format PDF atau TXT</span>
                        </label>
                        <% if(materi && materi.file_dokumen) { %>
                            <p class="existing-file">Dokumen tersimpan: <strong><%= materi.nama_file_asli || materi.file_dokumen.split('/').pop() %></strong></p>
                        <% } %>
                    </div>

                    <div class="form-actions">
                        <a href="/" class="secondary-button">Batal</a>
                        <button type="submit" class="primary-button form-submit"><span id="btnText">Simpan Materi</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
                    </div>
                </form>
            </section>
            <p class="form-footnote">LectureSum <span>•</span> Kelola materi perkuliahan dengan lebih praktis.</p>
        </main>
    </div>

    <script>
        const form = document.getElementById('materiForm'); // BARU
        const fileInput = document.getElementById('file_dokumen');
        const dropZone = document.getElementById('dropZone');
        const fileName = document.getElementById('fileName');

        function showFile(file) {
            if (!file) return;
            fileName.textContent = file.name;
            dropZone.classList.add('has-file');
        }
        fileInput.addEventListener('change', () => showFile(fileInput.files[0]));
        ['dragenter', 'dragover'].forEach(type => dropZone.addEventListener(type, event => {
            event.preventDefault(); dropZone.classList.add('is-dragging');
        }));
        ['dragleave', 'drop'].forEach(type => dropZone.addEventListener(type, event => {
            event.preventDefault(); dropZone.classList.remove('is-dragging');
        }));
        dropZone.addEventListener('drop', event => {
            const file = event.dataTransfer.files[0];
            if (file) {
                const transfer = new DataTransfer(); transfer.items.add(file); fileInput.files = transfer.files; showFile(file);
            }
        });

        // BARU
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const id = document.getElementById('materiId').value;
            const formData = new FormData();
            formData.append('mata_kuliah', document.getElementById('mataKuliah').value);
            formData.append('pertemuan', document.getElementById('pertemuan').value);
            formData.append('judul', document.getElementById('judul').value);
            formData.append('status', document.getElementById('status').value);
            const fileDokumen = fileInput.files[0];
            if (fileDokumen) formData.append('dokumen', fileDokumen);

            const button = form.querySelector('button[type="submit"]');
            const buttonText = document.getElementById('btnText');
            button.disabled = true;
            button.classList.add('is-loading');
            buttonText.textContent = fileDokumen ? 'AI Sedang Meringkas...' : 'Menyimpan...';
            try {
                const response = await fetch(id ? `/api/materi/${id}` : '/api/materi', { method: id ? 'PUT' : 'POST', body: formData });
                if (response.ok) window.location.href = '/';
                else throw new Error('Gagal menyimpan materi');
            } catch (error) {
                alert('Terjadi kesalahan saat memproses data. Periksa koneksi dan coba lagi.');
                button.disabled = false;
                button.classList.remove('is-loading');
                buttonText.textContent = 'Simpan Materi';
            }
        });
    </script>
</body>
</html>