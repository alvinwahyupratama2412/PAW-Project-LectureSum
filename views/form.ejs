<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/theme.js" defer></script>
</head>
<body>
    <div class="app-shell">
        <header class="topbar">
            <a class="brand" href="/" aria-label="LectureSum beranda">
                <span class="brand-mark">L</span>
                <span>Lecture<span class="brand-light">Sum</span></span>
            </a>
            <div class="topbar-actions">
                <span class="workspace-label"><span class="online-dot"></span> Ruang Dosen</span>
                <button class="theme-switch" id="themeToggle" type="button" role="switch" aria-checked="false" aria-label="Aktifkan tema gelap" title="Ganti tema">
                    <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.8"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
                    <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.7 8.7 0 1 0 20.5 14.1Z"/></svg>
                    <span class="switch-track"><span class="switch-thumb"></span></span>
                </button>
            </div>
        </header>

        <!-- BARU -->
        <main class="form-page">
            <a href="/" class="back-link"><span aria-hidden="true">←</span> Kembali ke dashboard</a>
            <section class="form-card">
                <div class="form-heading">
                    <div class="form-heading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                    </div>
                    <div>
                        <p class="eyebrow">MANAJEMEN PERKULIAHAN</p>
                        <h1><%= materi ? 'Edit Materi' : 'Tambah Materi Baru' %></h1>
                        <p class="page-subtitle">Lengkapi informasi materi dan unggah dokumen perkuliahan.</p>
                    </div>
                </div>

                <form id="materiForm" class="materi-form">
                    <input type="hidden" id="materiId" value="<%= materi ? materi.id : '' %>">
                    <div class="form-grid">
                        <div class="field-group">
                            <label for="mataKuliah">Mata Kuliah <span>*</span></label>
                            <input type="text" id="mataKuliah" value="<%= materi ? materi.mata_kuliah : '' %>" placeholder="Contoh: Pemrograman Web" required>
                        </div>
                        <div class="field-group">
                            <label for="pertemuan">Pertemuan <span>*</span></label>
                            <input type="number" id="pertemuan" value="<%= materi ? materi.pertemuan : '' %>" min="1" placeholder="Contoh: 7" required>
                        </div>
                        <div class="field-group field-full">
                            <label for="judul">Judul Materi <span>*</span></label>
                            <input type="text" id="judul" value="<%= materi ? materi.judul : '' %>" placeholder="Masukkan judul materi perkuliahan" required>
                        </div>
                        <div class="field-group field-full">
                            <label for="status">Status Materi</label>
                            <select id="status">
                                <option value="Belum dipelajari" <%= !materi || materi.status === 'Belum dipelajari' || materi.status === 'Draf' ? 'selected' : '' %>>Belum dipelajari</option>
                                <option value="Sedang dipelajari" <%= materi && materi.status === 'Sedang dipelajari' ? 'selected' : '' %>>Sedang dipelajari</option>
                                <option value="Sudah Dipelajari" <%= materi && (materi.status === 'Sudah Dipelajari' || materi.status === 'Terbit') ? 'selected' : '' %>>Sudah Dipelajari</option>
                            </select>
                            <small class="field-hint">Atur progres belajar materi ini.</small>
                        </div>
                    </div>
                    <!-- upload dan tombol ditambahkan di commit berikutnya -->
                </form>
            </section>
        </main>
    </div>
</body>
</html>