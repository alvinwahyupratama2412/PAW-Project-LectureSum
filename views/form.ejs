<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex justify-center py-8">
    <div class="w-full max-w-3xl bg-white shadow-sm border border-gray-200 p-8 h-fit">
        <h2 class="text-2xl font-bold text-gray-900 mb-6"><%= materi ? 'Edit Materi' : 'Tambah Materi Baru' %></h2>
        <form id="materiForm" class="space-y-4">
            <input type="hidden" id="materiId" value="<%= materi ? materi.id : '' %>">
            <div class="flex gap-4">
                <div class="w-1/2">
                    <label class="block text-xs font-bold text-gray-700 mb-1">Mata Kuliah *</label>
                    <input type="text" id="mataKuliah" value="<%= materi ? materi.mata_kuliah : '' %>" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                </div>
                <div class="w-1/2">
                    <label class="block text-xs font-bold text-gray-700 mb-1">Pertemuan *</label>
                    <input type="number" id="pertemuan" value="<%= materi ? materi.pertemuan : '' %>" min="1" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Judul Materi *</label>
                <input type="text" id="judul" value="<%= materi ? materi.judul : '' %>" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Status</label>
                <select id="status" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                    <option value="Draf" <%= materi && materi.status === 'Draf' ? 'selected' : '' %>>Draf</option>
                    <option value="Terbit" <%= materi && materi.status === 'Terbit' ? 'selected' : '' %>>Terbit</option>
                </select>
            </div>
            <div class="mt-4 p-4 border border-blue-100 bg-blue-50 rounded">
                <label class="block text-xs font-bold text-gray-700 mb-1">Upload Dokumen Materi (PDF) *</label>
                <input type="file" id="file_dokumen" accept=".pdf, .txt" class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white cursor-pointer">
                <p class="text-xs text-gray-500 mt-1">*Dokumen yang diunggah akan langsung dibaca dan diringkas oleh Gemini AI.</p>
                <% if(materi && materi.file_dokumen) { %>
                    <p class="text-xs text-blue-600 mt-2 font-semibold">Tersimpan: <%= materi.file_dokumen %></p>
                <% } %>
            </div>
            <div class="flex justify-between items-center pt-6 border-t mt-6">
                <a href="/" class="border border-gray-300 text-gray-700 px-4 py-2 rounded text-sm font-medium hover:bg-gray-100">Batal</a>
                <button type="submit" class="bg-gray-800 text-white px-4 py-2 rounded text-sm font-medium hover:bg-gray-900 transition flex items-center justify-center min-w-[150px]">
                    <span id="btnText">Simpan Data</span>
                </button>
            </div>
        </form>
    </div>
    <script>
        document.getElementById('materiForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('materiId').value;
            const formData = new FormData();
            
            formData.append('mata_kuliah', document.getElementById('mataKuliah').value);
            formData.append('pertemuan', document.getElementById('pertemuan').value);
            formData.append('judul', document.getElementById('judul').value);
            formData.append('status', document.getElementById('status').value);
            
            const fileDokumen = document.getElementById('file_dokumen').files[0];
            if (fileDokumen) formData.append('dokumen', fileDokumen);

            const btn = document.querySelector('button[type="submit"]');
            const btnText = document.getElementById('btnText');
            btn.disabled = true;
            btn.classList.add('opacity-70', 'cursor-not-allowed');
            btnText.innerText = fileDokumen ? 'AI Sedang Meringkas...' : 'Menyimpan...';

            try {
                const response = await fetch(id ? `/api/materi/${id}` : '/api/materi', {
                    method: id ? 'PUT' : 'POST',
                    body: formData
                });
                if(response.ok) window.location.href = '/';
                else throw new Error('Gagal');
            } catch (error) {
                alert('Terjadi kesalahan saat memproses data.');
                btn.disabled = false;
                btn.classList.remove('opacity-70', 'cursor-not-allowed');
                btnText.innerText = 'Simpan Data';
            }
        });
    </script>
</body>
</html>