<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/theme.js" defer></script>
</head>
<body>
<div class="app-shell">
        <header class="topbar">
        <a class="brand" href="/" aria-label="LectureSum beranda">
            <span class="brand-mark">L</span><span>Lecture<span class="brand-light">Sum</span></span>
        </a>
        <div class="topbar-actions">
            <span class="workspace-label"><span class="online-dot"></span> Ruang Dosen</span>
        </div>
    </header>

                <button class="theme-switch" id="themeToggle" type="button" role="switch" aria-checked="false" aria-label="Aktifkan tema gelap" title="Ganti tema">
                <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.8"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
                <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.7 8.7 0 1 0 20.5 14.1Z"/></svg>
                <span class="switch-track"><span class="switch-thumb"></span></span>
            </button>

    <main class="main-content">
        <section class="welcome-row">
            <div>
                <p class="eyebrow">WORKSPACE / MATERI KULIAH</p>
                <h1>Dashboard Materi</h1>
                <p class="page-subtitle">Kelola dokumen, ringkasan AI, dan progres perkuliahan dalam satu tempat.</p>
            </div>
            <a href="/form" class="primary-button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Tambah Materi
            </a>
        </section>

                <section class="stats-grid" aria-label="Ringkasan materi">
            <article class="stat-card">
                <div class="stat-icon total-icon"><svg viewBox="0 0 24 24"><path d="M7 3.8h7l4 4v12.4H7z"/><path d="M14 3.8v4h4M10 12h5M10 15.5h5"/></svg></div>
                <div><p>Total materi</p><strong><%= materi.length %></strong></div><span class="stat-note">Tersimpan</span>
            </article>
            <article class="stat-card">
                <div class="stat-icon published-icon"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.3 4.2L19 7"/></svg></div>
                <div><p>Sudah dipelajari</p><strong><%= materi.filter(item => item.status === 'Sudah Dipelajari').length %></strong></div><span class="stat-note">Selesai</span>
            </article>
            <article class="stat-card">
                <div class="stat-icon progress-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/></svg></div>
                <div><p>Sedang dipelajari</p><strong><%= materi.filter(item => item.status === 'Sedang dipelajari').length %></strong></div><span class="stat-note">Dalam proses</span>
            </article>
            <article class="stat-card">
                <div class="stat-icon draft-icon"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.3 4.2L19 7"/></svg></div>
                <div><p>Belum dipelajari</p><strong><%= materi.filter(item => item.status === 'Belum dipelajari').length %></strong></div><span class="stat-note">Perlu dipelajari</span>
            </article>
        </section>

                <section class="content-card">
            <div class="content-card-header">
                <div><h2>Daftar Materi</h2><p>Materi dikelompokkan berdasarkan mata kuliah.</p></div>
                <span class="count-pill"><%= materi.length %> materi</span>
            </div>

            <% if (materi.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">＋</div><h3>Belum ada materi</h3>
                    <p>Mulai dengan menambahkan materi perkuliahan pertamamu.</p>
                    <a href="/form" class="primary-button">Tambah Materi</a>
                </div>
            <% } else { %>
                                <div class="table-wrap">
                    <table class="materials-table">
                        <thead><tr>
                            <th>Judul Materi</th>
                            <th class="center-cell">Pertemuan</th>
                            <th>Status</th>
                            <th>Sumber</th>
                            <th class="action-heading"><span class="sr-only">Aksi</span></th>
                        </tr></thead>
                                                <% kelompokMateri.forEach(kelompok => { %>
                            <tbody class="course-group">
                                <tr class="course-group-heading"><th colspan="5"><span class="course-mark"><svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 5.5v15M8 7h8M8 10.5h7"/></svg></span><span><small>MATA KULIAH</small><strong><%= kelompok.nama %></strong></span><em><%= kelompok.items.length %> materi</em></th></tr>
                                                                <% kelompok.items.forEach(item => {
                                    const statusClass = item.status === 'Sudah Dipelajari' ? 'status-done' : item.status === 'Sedang dipelajari' ? 'status-progress' : 'status-not-started';
                                    const canOpen = Boolean(item.ringkasan);
                                %>
                                    <tr class="material-row <%= canOpen ? 'is-clickable' : '' %>" <% if (canOpen) { %>data-href="/materi/<%= encodeURIComponent(item.id) %>" tabindex="0" role="link" aria-label="Buka ringkasan <%= item.judul %>"<% } %>>
                                        <td><div class="material-cell"><div class="file-icon"><svg viewBox="0 0 24 24"><path d="M7 3.8h7l4 4v12.4H7z"/><path d="M14 3.8v4h4M10 12h5M10 15.5h5"/></svg></div><div class="material-info"><strong><%= item.judul %></strong><span><%= item.mata_kuliah %></span></div></div></td>
                                        <td class="center-cell"><span class="meeting-number"><%= item.pertemuan %></span></td>
                                        <td><span class="status-badge <%= statusClass %>"><span></span><%= item.status || 'Belum dipelajari' %></span></td>
                                                                                <td><% if (item.file_dokumen) { %><a class="source-link" href="<%= item.file_dokumen %>" target="_blank" rel="noopener" title="Buka dokumen sumber" onclick="event.stopPropagation()"><svg viewBox="0 0 24 24"><path d="M7 3.8h7l4 4v12.4H7z"/><path d="M14 3.8v4h4M10 13h5"/></svg><span><%= item.nama_file_asli || item.file_dokumen.split('/').pop() %></span></a><% } else { %><span class="muted-source">Belum ada file</span><% } %></td>
                                        <td class="actions-cell"><div class="action-group">
                                            <a href="/form?id=<%= item.id %>" class="icon-action edit-button" title="Edit materi" aria-label="Edit materi" onclick="event.stopPropagation()"><svg viewBox="0 0 24 24"><path d="m14 5 5 5M4 20l4.2-.9L19 8.3a2.1 2.1 0 0 0-3-3L5.2 16.1z"/></svg></a>
                                            <button type="button" class="icon-action delete-button" title="Hapus materi" aria-label="Hapus materi" onclick="event.stopPropagation(); hapusMateri('<%= item.id %>')"><svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m3 0-.8 13H6.8L6 7m4 4v5m4-5v5"/></svg></button>
                                        </div></td>
                                                        <p class="table-hint"><span>ⓘ</span> Pilih materi yang memiliki ringkasan untuk membukanya.</p>
                                                                <footer class="page-footer">LectureSum <span>•</span> Kelola materi perkuliahan dengan lebih praktis.</footer>
                                    </tr>
                                <% }) %>
                            </tbody>
                        <% }) %>
                        <script>
    document.querySelectorAll('.material-row.is-clickable').forEach(row => {
        const openRow = () => { window.location.href = row.dataset.href; };
        row.addEventListener('click', openRow);
        row.addEventListener('keydown', event => {
            if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openRow(); }
        });
    });
</script>
    async function hapusMateri(id) {
        if (!confirm('Yakin ingin menghapus materi ini?')) return;
        try {
            const response = await fetch(`/api/materi/${id}`, { method: 'DELETE' });
            if (response.ok) window.location.reload();
            else alert('Materi gagal dihapus. Silakan coba lagi.');
        } catch (error) { alert('Tidak dapat terhubung ke server.'); }
    }
                    </table>
                </div>
            <% } %>
        </section>
    </main>
</div>
</body>
</html>